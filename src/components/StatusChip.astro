---
interface Props {
  status: string;
}

const { status } = Astro.props;
---

<p class="label inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-3 py-1.5 text-muted">
  <span aria-hidden="true" class="relative flex size-2">
    <span class="absolute inline-flex size-full animate-ping rounded-full bg-clean-fill opacity-60 motion-reduce:hidden"></span>
    <span class="relative inline-flex size-2 rounded-full bg-clean-fill"></span>
  </span>
  <span>
    <span class="text-fg">Currently:</span> {status}
  </span>
</p>
