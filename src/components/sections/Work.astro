---
import { getCaseStudies } from '../../lib/content';
import { formatNumber, formatRange } from '../../lib/format';
import { url } from '../../lib/url';
import StageHeader from '../StageHeader.astro';

const projects = await getCaseStudies();
---

<section id="work" aria-labelledby="work-title" class="page scroll-mt-16 pt-section">
  <StageHeader stage="load" title="Case studies" id="work-title" />

  <ul class="grid gap-4 md:grid-cols-2">
    {projects.map((p, i) => (
      <li>
        <a
          href={url(`/work/${p.id}/`)}
          class="group flex h-full flex-col rounded-lg border border-line bg-surface p-6 transition-colors hover:border-fg md:p-8"
        >
          <div class="label flex items-center justify-between gap-4 text-muted">
            <span>
              {String(i + 1).padStart(2, '0')} · {p.data.sector}
            </span>
            <span>{formatRange(p.data.period.start, p.data.period.end)}</span>
          </div>

          <h3 class="mt-8 font-display text-display-sm uppercase">{p.data.title}</h3>
          <p class="mt-2 text-sm text-muted">{p.data.client}</p>
          <p class="mt-4 text-muted">{p.data.summary}</p>

          <p class="label mt-6 flex flex-wrap items-center gap-2 text-muted">
            <span class="text-dirty">{p.data.source.join(' + ')}</span>
            <span aria-hidden="true">→</span>
            <span class="sr-only">to</span>
            <span class="text-clean">{p.data.target.join(' + ')}</span>
          </p>

          <div class="mt-auto flex items-end justify-between gap-6 pt-8">
            <dl class="flex gap-8">
              {p.data.metrics.slice(0, 2).map((m) => (
                <div class="flex flex-col-reverse">
                  <dt class="mt-1 text-xs text-muted">{m.label}</dt>
                  <dd class="font-display text-3xl">
                    {m.prefix}
                    {formatNumber(m.value)}
                    {m.suffix && <span class="text-clean">{m.suffix}</span>}
                  </dd>
                </div>
              ))}
            </dl>
            <span
              aria-hidden="true"
              class="label shrink-0 text-muted transition-colors group-hover:text-clean"
            >
              Read →
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
