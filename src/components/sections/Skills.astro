---
/**
 * Skills as a schema query (see SkillsSchema.astro), then study and certification.
 */
import { getCollection } from 'astro:content';
import { formatRange } from '../../lib/format';
import SkillsSchema from '../SkillsSchema.astro';
import StageHeader from '../StageHeader.astro';

const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
const certifications = await getCollection('certifications');
---

<section id="skills" aria-labelledby="skills-title" class="page scroll-mt-16 pt-section">
  <StageHeader stage="model" title="Skills & study" id="skills-title" />

  <SkillsSchema />

  <div class="mt-16 grid gap-12 md:grid-cols-2">
    <div>
      <h3 class="label mb-6 text-muted">Education</h3>
      <ul class="divide-y divide-line border-y border-line">
        {education.map((e) => (
          <li id={`edu-${e.id}`} class="scroll-mt-24 py-6">
            <p class="label text-muted">{formatRange(e.data.start, e.data.end)}</p>
            <p class="mt-3 text-lg text-fg">{e.data.qualification}</p>
            <p class="mt-1 text-muted">
              {e.data.institution} · {e.data.location}
            </p>
            {e.data.coursework.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Relevant coursework">
                {e.data.coursework.map((c) => (
                  <li class="label rounded-full border border-line px-3 py-1 text-muted">{c}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="label mb-6 text-muted">Certification</h3>
      <ul class="divide-y divide-line border-y border-line">
        {certifications.map((c) => (
          <li class="flex items-start gap-4 py-6">
            <span
              aria-hidden="true"
              class="label mt-1 rounded-sm bg-clean-fill px-1.5 py-0.5 text-on-fill"
            >
              ✓
            </span>
            <div>
              <p class="text-lg text-fg">
                {c.data.badgeUrl ? (
                  <a
                    href={c.data.badgeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline decoration-line underline-offset-4 hover:decoration-clean"
                  >
                    {c.data.name}
                  </a>
                ) : (
                  c.data.name
                )}
              </p>
              <p class="mt-1 text-muted">
                {c.data.issuer}
                {c.data.year && ` · ${c.data.year}`}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
