---
/**
 * Section header styled as a pipeline stage: "01 / EXTRACT ───── About".
 * The site reads top to bottom as Extract → Transform → Load → Model → Output.
 */
import { STAGES, type Stage } from '../lib/stages';

interface Props {
  stage: Stage;
  title: string;
  id?: string;
}

const { stage, title, id } = Astro.props;
const index = String(STAGES.indexOf(stage) + 1).padStart(2, '0');
---

<header class="mb-12 md:mb-16">
  <div class="label flex items-center gap-3 text-muted">
    <span aria-hidden="true" class="size-2 bg-clean"></span>
    <span>
      {index} / {stage}
    </span>
    <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
  </div>
  <h2 id={id} class="mt-6 font-display text-display-md uppercase">
    {title}
  </h2>
</header>
