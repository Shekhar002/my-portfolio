---
import { getProfile } from '../lib/content';

const profile = await getProfile();
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="page label flex flex-col gap-3 py-8 text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {profile.name} · {profile.location}
    </p>
    <p>
      Press <kbd class="rounded border border-line px-1">/</kbd> to query this site · Built with
      Astro
    </p>
  </div>
</footer>
