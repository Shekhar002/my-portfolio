---
/**
 * Social share card template (1200 × 630). Never part of the normal build:
 * pages are only generated with `astro build --mode og`, which
 * `npm run og` (scripts/og-images.mjs) runs and screenshots into public/og/.
 */
import type { GetStaticPaths } from 'astro';
import { Font } from 'astro:assets';
import '../../styles/global.css';
import { getCaseStudies, getProfile } from '../../lib/content';
import { formatNumber } from '../../lib/format';

interface Card {
  eyebrow: string;
  title: string;
  subtitle: string;
  metrics: { value: number; suffix?: string; label: string }[];
}

export const getStaticPaths = (async () => {
  if (import.meta.env.MODE !== 'og') return [];
  const profile = await getProfile();
  const projects = await getCaseStudies();
  return [
    {
      params: { slug: 'default' },
      props: {
        eyebrow: `${profile.headline} · ${profile.location}`,
        title: profile.name,
        subtitle: profile.tagline,
        metrics: [],
      } satisfies Card,
    },
    ...projects.map((p) => ({
      params: { slug: `work-${p.id}` },
      props: {
        eyebrow: `Case study · ${p.data.client}`,
        title: p.data.title,
        subtitle: `${p.data.source.join(' + ')} → ${p.data.target.join(' + ')}`,
        metrics: p.data.metrics.slice(0, 3),
      } satisfies Card,
    })),
  ];
}) satisfies GetStaticPaths;

const card = Astro.props as Card;
const profile = await getProfile();
const isDefault = card.metrics.length === 0;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{card.title}</title>
    <Font cssVariable="--font-league-gothic" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      .dot-rows {
        background-image: radial-gradient(var(--c-fg) 2px, transparent 2.6px);
        background-size: 22px 22px;
        opacity: 0.4;
      }
      .header {
        background-image: radial-gradient(var(--c-clean) 2.4px, transparent 3px);
        background-size: 22px 22px;
      }
    </style>
  </head>
  <body class="bg-data-grid bg-bg text-fg">
    <div data-card class="relative flex h-[630px] w-[1200px] flex-col justify-between p-16">
      <!-- Decorative loaded table, right side -->
      <div aria-hidden="true" class="absolute top-16 right-16 h-[300px] w-[330px]">
        <div class="header h-[22px]"></div>
        <div class="dot-rows mt-3 h-[260px]"></div>
      </div>

      <p class="label flex items-center gap-3 text-base text-muted">
        <span class="size-3 bg-clean"></span>
        {card.eyebrow}
      </p>

      <div class="max-w-[760px]">
        <h1
          class:list={[
            'font-display leading-[0.88] uppercase',
            isDefault ? 'text-[150px]' : card.title.length > 32 ? 'text-[88px]' : 'text-[104px]',
          ]}
        >
          {card.title}
        </h1>
        <p class="mt-6 font-mono text-xl text-muted">{card.subtitle}</p>
      </div>

      <div class="flex items-end justify-between gap-8">
        {isDefault ? (
          <p class="label text-base text-muted">source → transform → target</p>
        ) : (
          <dl class="flex gap-12">
            {card.metrics.map((m) => (
              <div class="flex flex-col-reverse">
                <dt class="mt-1 text-lg text-muted">{m.label}</dt>
                <dd class="font-display text-6xl">
                  {formatNumber(m.value)}
                  {m.suffix && <span class="text-clean">{m.suffix}</span>}
                </dd>
              </div>
            ))}
          </dl>
        )}
        <p class="label text-base text-fg">{profile.name}</p>
      </div>
    </div>
  </body>
</html>
