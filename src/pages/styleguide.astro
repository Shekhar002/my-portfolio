---
/**
 * /styleguide: internal reference for design tokens and base components.
 * Not linked from the site and marked noindex. Counts in the content-model
 * section are read live from the Content Collections.
 */
import { getCollection, getEntry } from 'astro:content';
import Button from '../components/Button.astro';
import StageHeader from '../components/StageHeader.astro';
import StatusChip from '../components/StatusChip.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Layout from '../layouts/Layout.astro';
import { formatNumber } from '../lib/format';
import { STAGES } from '../lib/stages';
import { url } from '../lib/url';

const profile = await getEntry('profile', 'shekhar');
if (!profile) throw new Error('src/content/profile.json must contain a "shekhar" entry');

const [experience, projects, skills, education, certifications] = await Promise.all([
  getCollection('experience'),
  getCollection('projects'),
  getCollection('skills'),
  getCollection('education'),
  getCollection('certifications'),
]);

const tables = [
  { name: 'experience', rows: experience.length },
  { name: 'projects', rows: projects.length },
  { name: 'skills', rows: skills.length },
  { name: 'education', rows: education.length },
  { name: 'certifications', rows: certifications.length },
];

const featured = projects.sort((a, b) => a.data.order - b.data.order)[0];

const colourGroups = [
  {
    title: 'Surfaces',
    tokens: [
      { name: 'bg', usage: 'Page background' },
      { name: 'surface', usage: 'Cards, chips, raised panels' },
      { name: 'line', usage: 'Borders, rules, dot grid' },
    ],
  },
  {
    title: 'Text',
    tokens: [
      { name: 'fg', usage: 'Headings and body', text: true },
      { name: 'muted', usage: 'Secondary copy, labels', text: true },
      { name: 'subtle', usage: 'Decoration only. Never carries meaning.', text: true },
    ],
  },
  {
    title: 'Signal',
    tokens: [
      { name: 'clean', usage: 'Validated / transformed data (text-safe)', text: true },
      { name: 'dirty', usage: 'Raw / conflicting / failed data (text-safe)', text: true },
      { name: 'clean-fill', usage: 'Fills behind ink text: CTAs, selection' },
      { name: 'dirty-fill', usage: 'Fills behind ink text: error badges' },
    ],
  },
];

const typeScale = [
  { token: 'text-display-xl', sample: 'Shekhar', class: 'text-display-xl' },
  { token: 'text-display-lg', sample: 'Source → Target', class: 'text-display-lg' },
  { token: 'text-display-md', sample: 'Experience', class: 'text-display-md' },
  { token: 'text-display-sm', sample: 'Rescuing a payroll migration', class: 'text-display-sm' },
];

const levelBar = { expert: 3, advanced: 2, working: 1 } as const;
---

<Layout title="Styleguide · Shekhar Tyagi" noindex>
  <div class="bg-data-grid min-h-dvh">
    <main class="page py-16 md:py-24">
      <!-- Intro -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="label text-muted">internal · /styleguide · noindex</p>
        <ThemeToggle />
      </div>
      <h1 class="mt-10 font-display text-display-xl uppercase">Styleguide</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Design tokens and base components for the site. The theme is <em>noise → structure</em>: a
        monochrome canvas where <span class="text-dirty">red marks raw, broken data</span> and{' '}
        <span class="text-clean">lime marks data that has been cleaned and loaded</span>.
      </p>
      <div class="mt-8">
        <StatusChip status={profile.data.status} />
      </div>

      <!-- Colour -->
      <section class="mt-section" aria-labelledby="sg-colour">
        <StageHeader stage="extract" title="Colour" id="sg-colour" />
        <p class="mb-10 max-w-2xl text-muted">
          Contrast ratios are measured live against <code class="font-mono text-fg">bg</code> in the
          current theme. Text tokens need ≥ 4.5:1. Toggle the theme to check both.
        </p>
        <div class="grid gap-12">
          {colourGroups.map((group) => (
            <div>
              <h3 class="label mb-4 text-muted">{group.title}</h3>
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {group.tokens.map((t) => (
                  <li class="overflow-hidden rounded-lg border border-line bg-surface">
                    <div
                      class="h-24 border-b border-line"
                      style={`background: var(--c-${t.name})`}
                    />
                    <div class="space-y-1 p-4">
                      <p class="font-mono text-sm text-fg">{t.name}</p>
                      <p class="text-sm text-muted">{t.usage}</p>
                      <p class="label pt-2 text-muted">
                        <span data-hex={t.name} />
                        {'text' in t && t.text && (
                          <>
                            {' · '}
                            <span data-contrast={t.name} />
                          </>
                        )}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Semantic demo -->
        <div class="mt-12 overflow-x-auto rounded-lg border border-line bg-surface">
          <table class="w-full min-w-[34rem] font-mono text-sm">
            <caption class="label border-b border-line p-4 text-left text-muted">
              Signal colours in use: one record, before and after transformation
            </caption>
            <thead class="label text-muted">
              <tr class="border-b border-line">
                <th scope="col" class="p-4 text-left font-normal">
                  field
                </th>
                <th scope="col" class="p-4 text-left font-normal">
                  source
                </th>
                <th scope="col" class="p-4 text-left font-normal">
                  target
                </th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-line">
                <td class="p-4 text-muted">start_date</td>
                <td class="p-4 text-dirty">
                  31/02/2019 <span aria-label="invalid">✕</span>
                </td>
                <td class="p-4 text-clean">
                  2019-02-28 <span aria-label="valid">✓</span>
                </td>
              </tr>
              <tr class="border-b border-line">
                <td class="p-4 text-muted">pay_component</td>
                <td class="p-4 text-dirty">
                  BASE, BASE_ALT <span aria-label="conflict">✕</span>
                </td>
                <td class="p-4 text-clean">
                  BASE <span aria-label="valid">✓</span>
                </td>
              </tr>
              <tr>
                <td class="p-4 text-muted">tax_file_no</td>
                <td class="p-4 text-dirty">
                  123 456 782 <span aria-label="unmasked">✕</span>
                </td>
                <td class="p-4 text-clean">
                  *** *** *** <span aria-label="masked">✓</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Type -->
      <section class="mt-section" aria-labelledby="sg-type">
        <StageHeader stage="transform" title="Typography" id="sg-type" />
        <div class="grid gap-3 md:grid-cols-3">
          <div class="rounded-lg border border-line bg-surface p-5">
            <p class="label text-muted">Display · font-display</p>
            <p class="mt-3 font-display text-4xl uppercase">League Gothic</p>
            <p class="mt-2 text-sm text-muted">Headings only. Always uppercase.</p>
          </div>
          <div class="rounded-lg border border-line bg-surface p-5">
            <p class="label text-muted">Body · font-sans</p>
            <p class="mt-3 text-2xl">Inter</p>
            <p class="mt-2 text-sm text-muted">Paragraphs, UI, long-form case studies.</p>
          </div>
          <div class="rounded-lg border border-line bg-surface p-5">
            <p class="label text-muted">Data · font-mono</p>
            <p class="mt-3 font-mono text-2xl">JetBrains Mono</p>
            <p class="mt-2 text-sm text-muted">Labels, stage names, tables, code, metrics.</p>
          </div>
        </div>

        <div class="mt-12 divide-y divide-line border-y border-line">
          {typeScale.map((t) => (
            <div class="grid gap-2 py-8 md:grid-cols-[12rem_1fr] md:items-end">
              <p class="label text-muted">{t.token}</p>
              <p class:list={['font-display uppercase break-words', t.class]}>{t.sample}</p>
            </div>
          ))}
          <div class="grid gap-2 py-8 md:grid-cols-[12rem_1fr]">
            <p class="label text-muted">text-lg / base / sm</p>
            <div class="max-w-2xl space-y-4">
              <p class="text-lg">{profile.data.bio[0]}</p>
              <p class="text-base text-muted">{profile.data.bio[1]}</p>
              <p class="text-sm text-muted">Small: captions, metadata, footnotes.</p>
            </div>
          </div>
          <div class="grid gap-2 py-8 md:grid-cols-[12rem_1fr]">
            <p class="label text-muted">.label</p>
            <p class="label">01 / extract · Jun 2025 – Present · SAP HANA</p>
          </div>
          <div class="grid gap-2 py-8 md:grid-cols-[12rem_1fr]">
            <p class="label text-muted">code</p>
            <pre class="overflow-x-auto rounded-lg border border-line bg-surface p-5 font-mono text-sm leading-relaxed"><code><span class="text-muted">-- one primary record per employee</span>
<span class="text-clean">SELECT</span> *
<span class="text-clean">FROM</span> (
  <span class="text-clean">SELECT</span> e.*, <span class="text-clean">ROW_NUMBER() OVER</span> (
    <span class="text-clean">PARTITION BY</span> person_id <span class="text-clean">ORDER BY</span> is_primary <span class="text-clean">DESC</span>
  ) <span class="text-clean">AS</span> rn
  <span class="text-clean">FROM</span> stg_employee e
) <span class="text-clean">WHERE</span> rn = 1;</code></pre>
          </div>
        </div>
      </section>

      <!-- Components -->
      <section class="mt-section" aria-labelledby="sg-components">
        <StageHeader stage="load" title="Components" id="sg-components" />

        <h3 class="label mb-4 text-muted">Stage labels: section order of the site</h3>
        <ol class="mb-12 grid gap-2 sm:grid-cols-5">
          {STAGES.map((s, i) => (
            <li class="label flex items-center gap-2 rounded-lg border border-line bg-surface p-4">
              <span aria-hidden="true" class="size-2 bg-clean-fill" />
              {String(i + 1).padStart(2, '0')} / {s}
            </li>
          ))}
        </ol>

        <h3 class="label mb-4 text-muted">Buttons & links</h3>
        <div class="mb-12 flex flex-wrap items-center gap-4">
          <Button href={url(profile.data.links.cv)} download>
            Download CV
          </Button>
          <Button href={profile.data.links.linkedin} variant="secondary">
            LinkedIn
          </Button>
          <Button href={profile.data.links.github} variant="secondary">
            GitHub
          </Button>
          <a
            href="#sg-colour"
            class="underline decoration-line underline-offset-4 transition-colors hover:decoration-clean"
          >
            Inline text link
          </a>
        </div>

        <h3 class="label mb-4 text-muted">Stack tags</h3>
        <ul class="mb-12 flex flex-wrap gap-2">
          {featured?.data.stack.map((s) => (
            <li class="label rounded-full border border-line px-3 py-1 text-muted">{s}</li>
          ))}
        </ul>

        <h3 class="label mb-4 text-muted">
          Metric tiles: {featured?.data.title} (static; counters animate in Phase 3)
        </h3>
        <ul class="mb-12 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-5">
          {featured?.data.metrics.map((m) => (
            <li class="bg-surface p-5">
              <p class="font-display text-display-sm">
                {m.prefix}
                {formatNumber(m.value)}
                <span class="text-clean">{m.suffix}</span>
              </p>
              <p class="mt-2 text-sm text-muted">{m.label}</p>
            </li>
          ))}
        </ul>

        <h3 class="label mb-4 text-muted">Schema row: preview of the skills view</h3>
        <div class="overflow-x-auto rounded-lg border border-line bg-surface">
          <table class="w-full min-w-[30rem] font-mono text-sm">
            <caption class="sr-only">Sample of skills as a table definition</caption>
            <thead class="label text-muted">
              <tr class="border-b border-line">
                <th scope="col" class="p-4 text-left font-normal">
                  column
                </th>
                <th scope="col" class="p-4 text-left font-normal">
                  type
                </th>
                <th scope="col" class="p-4 text-left font-normal">
                  proficiency
                </th>
              </tr>
            </thead>
            <tbody>
              {skills.slice(0, 5).map((s) => (
                <tr class="border-b border-line last:border-0">
                  <td class="p-4">{s.data.name}</td>
                  <td class="p-4 text-muted">{s.data.category}</td>
                  <td class="p-4">
                    <span class="inline-flex items-center gap-3">
                      <span aria-hidden="true" class="flex gap-1">
                        {[1, 2, 3].map((n) => (
                          <span
                            class:list={[
                              'h-2 w-5 rounded-sm',
                              n <= levelBar[s.data.level] ? 'bg-clean-fill' : 'bg-line',
                            ]}
                          />
                        ))}
                      </span>
                      <span class="text-muted">{s.data.level}</span>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Content model -->
      <section class="mt-section" aria-labelledby="sg-content">
        <StageHeader stage="model" title="Content model" id="sg-content" />
        <p class="mb-8 max-w-2xl text-muted">
          All copy comes from <code class="font-mono text-fg">src/content/</code> and is validated
          by the Zod schemas in <code class="font-mono text-fg">src/content.config.ts</code>. These
          counts are queried at build time.
        </p>
        <pre class="overflow-x-auto rounded-lg border border-line bg-surface p-5 font-mono text-sm leading-relaxed"><code><span class="text-clean">SELECT</span> table_name, row_count <span class="text-clean">FROM</span> shekhar.collections;

{tables.map((t) => `${t.name.padEnd(16)}${String(t.rows).padStart(4)}\n`).join('')}
<span class="text-muted">({tables.length} rows)</span></code></pre>
      </section>

      <!-- Output -->
      <section class="mt-section" aria-labelledby="sg-surface">
        <StageHeader stage="output" title="Surfaces & grid" id="sg-surface" />
        <div class="grid gap-4 md:grid-cols-3">
          <div class="rounded-lg border border-line bg-bg p-6">
            <p class="label text-muted">bg + dot grid (page)</p>
          </div>
          <div class="rounded-lg border border-line bg-surface p-6">
            <p class="label text-muted">surface + line border</p>
          </div>
          <div class="rounded-lg bg-clean-fill p-6 text-on-fill">
            <p class="label">clean-fill + on-fill</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  function luminance(hex: string): number {
    const n = hex.replace('#', '').trim();
    const full =
      n.length === 3
        ? n
            .split('')
            .map((c) => c + c)
            .join('')
        : n;
    const [r, g, b] = [0, 2, 4].map((i) => {
      const c = parseInt(full.slice(i, i + 2), 16) / 255;
      return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  }

  function ratio(a: string, b: string): number {
    const [l1, l2] = [luminance(a), luminance(b)].sort((x, y) => y - x);
    return (l1 + 0.05) / (l2 + 0.05);
  }

  function measure() {
    const style = getComputedStyle(document.documentElement);
    const token = (name: string) => style.getPropertyValue(`--c-${name}`).trim();
    const bg = token('bg');

    document.querySelectorAll<HTMLElement>('[data-hex]').forEach((el) => {
      el.textContent = token(el.dataset.hex!);
    });
    document.querySelectorAll<HTMLElement>('[data-contrast]').forEach((el) => {
      const r = ratio(token(el.dataset.contrast!), bg);
      el.textContent = `${r.toFixed(2)}:1 ${r >= 4.5 ? 'AA' : r >= 3 ? 'UI only' : 'decor'}`;
      el.className = r >= 4.5 ? 'text-clean' : 'text-dirty';
    });
  }

  measure();
  new MutationObserver(measure).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
