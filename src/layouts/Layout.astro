---
import { Font } from 'astro:assets';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';
import { getProfile } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Keep internal pages (e.g. /styleguide) out of search results. */
  noindex?: boolean;
  /** Social share image under public/, e.g. "/og/default.png". */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Structured data (schema.org) for this page. Never include email or phone. */
  jsonLd?: Record<string, unknown>;
}

const profile = await getProfile();
const {
  title,
  description = profile.tagline,
  noindex = false,
  ogImage = '/og/default.png',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(url(ogImage), Astro.site).href;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <!-- Social sharing -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Icons and browser chrome -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f2ee" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Runs before paint so a saved light theme doesn't flash dark first. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        /* storage blocked: keep the dark default */
      }
    </script>
    <Font cssVariable="--font-league-gothic" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="bg-bg text-fg">
    <slot />
    <CommandPalette />
  </body>
</html>
