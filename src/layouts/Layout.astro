---
import { Font } from 'astro:assets';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Keep internal pages (e.g. /styleguide) out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = 'Technical Data Consultant: ETL pipelines on SAP HANA and SAP SuccessFactors data migration.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Runs before paint so a saved light theme doesn't flash dark first. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        /* storage blocked: keep the dark default */
      }
    </script>
    <Font cssVariable="--font-league-gothic" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body class="bg-bg text-fg">
    <slot />
    <CommandPalette />
  </body>
</html>
